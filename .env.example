# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Single hardcoded user
AUTH_USERNAME=admin
# Generate with: uv run python scripts/hash_password.py "your-password"
AUTH_PASSWORD_HASH=

# Random string used to sign session cookies, e.g. `python -c "import secrets;print(secrets.token_hex(32))"`
SECRET_KEY=change-me

# Optional overrides
DB_PATH=data/expenses.db
UPLOAD_DIR=uploads

# Used by docker-compose (nginx + certbot) to issue the HTTPS certificate.
DOMAIN=expense-tracker.site
CERTBOT_EMAIL=pozdeevbotalik@gmail.com
# Timezone for showing times on the Claude usage page, e.g. Europe/Berlin
TIMEZONE=UTC

# Model for "Спросить" (questions about spending) and how hard it thinks.
# ASK_MODEL=claude-sonnet-5
# ASK_EFFORT=medium

# Daily database backup to Telegram (the "backup" compose service).
# Bot: @BotFather → /newbot. Chat id: write to the bot, then open
# https://api.telegram.org/bot<TOKEN>/getUpdates and take message.chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Local hour (see TIMEZONE) when the backup is sent.
BACKUP_HOUR=4
